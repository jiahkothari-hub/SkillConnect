<?xml version="1.0" encoding="utf-8"?>
<!-- 14. Firebase Authentication -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Firebase Login"
                android:textColor="@color/purple"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivEmail"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_box"
                    android:contentDescription="email"
                    android:padding="14dp"
                    android:src="@drawable/ic_email" />

                <ImageView
                    android:id="@+id/ivGoogle"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_box"
                    android:contentDescription="google"
                    android:padding="14dp"
                    android:src="@drawable/ic_google" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Choose your sign in method"
                android:textColor="@color/purple" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmailSignIn"
                style="@style/FullButton"
                android:text="Sign in with Email" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleSignIn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sign in with Google"
                app:icon="@drawable/ic_google"
                app:iconTint="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Secure • Fast • Reliable"
                android:textColor="@color/grey" />

            <TextView
                android:id="@+id/tvUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@color/purple_light"
                android:gravity="center"
                android:padding="10dp"
                android:textColor="@color/black" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSync"
                style="@style/FullButton"
                android:text="Sync with Firebase" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewData"
                style="@style/FullButton"
                android:text="View Firebase Data" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFirebaseLogout"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sign out of Firebase" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
