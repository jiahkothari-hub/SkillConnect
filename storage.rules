rules_version = '2';

// SkillConnect – Firebase Storage security rules
service firebase.storage {
  match /b/{bucket}/o {

    function isImage() {
      return request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024;
    }

    // profile_images/{userId}.jpg – only the owner can upload their photo
    match /profile_images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName == request.auth.uid + '.jpg' && isImage();
      allow delete: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    // portfolio/{providerId}/{imageId}.jpg – only that provider can upload/delete
    match /portfolio/{providerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == providerId && isImage();
      allow delete: if request.auth != null && request.auth.uid == providerId;
    }
  }
}
